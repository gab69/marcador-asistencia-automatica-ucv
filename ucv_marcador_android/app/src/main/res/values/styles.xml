<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">UCV Marcador</string>

    <color name="azul_oscuro">#14213D</color>
    <color name="azul">#1C5FA8</color>
    <color name="fondo">#F3F5F8</color>
    <color name="borde">#DDE3EA</color>
    <color name="texto">#1F2937</color>
    <color name="texto_suave">#6B7280</color>
    <color name="blanco">#FFFFFF</color>

    <style name="Tema" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/azul_oscuro</item>
        <item name="android:colorPrimaryDark">@color/azul_oscuro</item>
        <item name="android:colorAccent">@color/azul</item>
        <item name="android:statusBarColor">@color/azul_oscuro</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <style name="Tarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/tarjeta</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="TituloTarjeta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Ayuda">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/texto_suave</item>
    </style>

    <style name="BotonPrimario">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/boton_primario</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BotonSecundario" parent="BotonPrimario">
        <item name="android:background">@drawable/boton_secundario</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="BotonPeligro" parent="BotonPrimario">
        <item name="android:background">@drawable/boton_peligro</item>
        <item name="android:textColor">#B91C1C</item>
    </style>

    <style name="BotonHora" parent="BotonSecundario">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
